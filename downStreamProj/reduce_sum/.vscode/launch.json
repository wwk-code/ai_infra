{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CUDA-GDB: reduce_sum (在kernel内部断点)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/downStreamProj/reduce_sum/outputs/app",
            "args": ["2", "64", "64", "64"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/downStreamProj/reduce_sum",
            "environment": [
                {
                    "name": "CUDA_VISIBLE_DEVICES",
                    "value": "0"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/local/cuda-12.6/bin/cuda-gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set CUDA break on launch all",
                    "text": "set cuda break_on_launch all",
                    "ignoreFailures": false
                },
                {
                    "description": "在gpu_sgemm_kernel函数入口设置断点",
                    "text": "break gpu_sgemm_kernel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}


