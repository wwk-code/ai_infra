                    "value": "1"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/local/cuda-12.4/bin/cuda-gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        //////////////////////////////////////////////////   CUDA-GDB debug configuration for test_cuda_gdb ////////////////////////////////////////
        {
            "name": "CUDA-GDB(Naive)",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "/data/workspace/projects/ai_infra/test_cuda_gdb/build/cuda_debug_test",
        },
        {
            "name": "CUDA-GDB: test_cuda_gdb (vectorAdd) - Console Mode",
            "type": "cppdbg",
            "request": "launch",
            "program": "/data/workspace/projects/ai_infra/test_cuda_gdb/build/cuda_debug_test",
            "args": [],
            "stopAtEntry": false,
            "cwd": "/data/workspace/projects/ai_infra/test_cuda_gdb/build",
            "environment": [
                {
                    "name": "CUDA_VISIBLE_DEVICES",
                    "value": "0"
                },
                {
